# ==============================================================================
# PolicySetu AI - Environment Configuration Template
# Copy this file to .env and fill in your keys: cp .env.example .env
# ==============================================================================

# --- Indic Speech & Translation (Sarvam AI) ---
# Sign up for ₹100 free credits at: https://www.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_BASE_URL=https://api.sarvam.ai

# --- LLM Orchestration & Embeddings (Google Gemini) ---
# Get free API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Live Vector Store (Qdrant Cloud) ---
# Create permanent free 1GB cluster at: https://cloud.qdrant.io
# Leave QDRANT_URL empty to automatically run in local disk/in-memory mode
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=policy_mandates

# --- Session & Media Store (Supabase) ---
# Create free project at: https://supabase.com
# Leave empty to automatically fallback to local SQLite + local media hosting
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=voice-notes

# --- Live Public Government Data ---
# Open-Meteo & OpenStreetMap (OSM) require NO API KEY (100% free public APIs)
# Free Data.gov.in API key from: https://data.gov.in
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Optional: Google Places API (Falls back to OpenStreetMap Overpass API if blank)
GOOGLE_PLACES_API_KEY=

# --- Server & Deployment Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_PUBLIC_URL=http://localhost:8000
ENVIRONMENT=development
